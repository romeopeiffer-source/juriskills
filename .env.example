# ==============================================
# Base de données (PostgreSQL — Supabase)
# ==============================================
# URL de connexion "pooled" (utilisée par l'app)
DATABASE_URL="postgresql://postgres:password@db.xxxxx.supabase.co:6543/postgres?pgbouncer=true"
# URL de connexion directe (utilisée par les migrations Prisma)
DIRECT_URL="postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres"

# ==============================================
# NextAuth
# ==============================================
# Générez une valeur aléatoire avec : openssl rand -base64 32
NEXTAUTH_SECRET="changez-moi"
NEXTAUTH_URL="http://localhost:3000"

# ==============================================
# Compte administrateur
# ==============================================
# Ne jamais mettre le mot de passe en clair ici.
# Générez ces valeurs avec : npm run admin:generate
# IMPORTANT : Next.js applique une expansion des variables $VAR dans les fichiers .env, même entre
# guillemets. Le hash bcrypt contient des symboles $ (ex: $2a$12$...) : chaque $ DOIT être échappé
# avec un antislash (\$), sinon le hash sera corrompu au chargement et l'admin ne pourra jamais se
# connecter. Le script `npm run admin:generate` génère directement la ligne au bon format.
ADMIN_EMAIL="admin@juriskills.fr"
ADMIN_PASSWORD_HASH="\$2a\$12\$hash-bcrypt-genere"

# ==============================================
# Stripe
# ==============================================
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ==============================================
# Supabase Storage
# ==============================================
SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="clé-service-role-secrete"

# ==============================================
# Emails transactionnels (Resend)
# ==============================================
RESEND_API_KEY="re_..."
EMAIL_FROM="Juriskills <achats@votredomaine.fr>"
